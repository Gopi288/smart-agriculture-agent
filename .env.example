# Smart Agriculture Agent — Environment Variables Reference
# Copy this file to .env for local development.
# NEVER commit the real .env file — it is in .gitignore.

# ── Flask Core ──────────────────────────────────────────────────────────────
# Must be set to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-chars

# 'production' disables DEBUG and uses ProductionConfig.
# 'development' enables debug mode (never use in production).
FLASK_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Absolute or relative path to the SQLite database file.
# Default (if unset): smart_agri.db in the project root.
# On Render free tier, the filesystem is ephemeral — data resets on each deploy.
# For persistence, mount a Render Disk or migrate to PostgreSQL.
DATABASE_PATH=smart_agri.db

# ── ML Model ────────────────────────────────────────────────────────────────
# These default to the bundled model — only set if using a custom model.
MODEL_PATH=ml/models/mobilenetv2_crop_disease.pth
CLASS_INDICES_PATH=ml/models/class_indices.json

# Confidence gate: predictions below this threshold are flagged as inconclusive.
CONFIDENCE_THRESHOLD=0.70

# Uncertainty gate: if top-1 and top-2 margin is below this, flag as ambiguous.
UNCERTAINTY_MARGIN=0.15

# ── Weather API (Optional) ───────────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
# If left empty, the app runs in resilient offline/manual mode — no errors.
OPENWEATHER_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# Only used when running the dev server directly (python app.py).
# Render sets PORT automatically — do not override it in render.yaml.
PORT=5000
