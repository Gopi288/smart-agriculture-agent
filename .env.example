# Flask Settings
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
PORT=5000

# OpenWeatherMap API Configuration (Optional)
# Obtain a free API key at https://openweathermap.org/api
# If left empty, the application runs seamlessly in resilient Offline/Manual mode
OPENWEATHER_API_KEY=

# Model Inference Configuration
CONFIDENCE_THRESHOLD=0.70
UNCERTAINTY_MARGIN=0.15
MODEL_PATH=ml/models/mobilenetv2_crop_disease.pth
CLASS_INDICES_PATH=ml/models/class_indices.json
DATABASE_PATH=smart_agri.db
